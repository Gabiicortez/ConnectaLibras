<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Reconhecimento local: não herdar permissões de rede das bibliotecas. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <application
        android:allowBackup="false"
        android:label="ConnectaLibras"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ConnectaLibras">

        <activity
            android:name=".activities.SplashActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity
            android:name=".activities.MainActivity"
            android:exported="false" />

        <activity
            android:name=".activities.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".activities.CadastroActivity"
            android:exported="false" />

        <activity
            android:name=".activities.HomeActivity"
            android:exported="false" />

        <activity
            android:name=".activities.ConversaActivity"
            android:exported="false" />

        <activity
            android:name=".activities.PerfilActivity"
            android:exported="false" />

        <activity
            android:name=".activities.EditarPerfilActivity"
            android:exported="false" />

        <activity
            android:name=".activities.ConfiguracoesActivity"
            android:exported="false" />

        <activity
            android:name=".activities.AlterarSenhaActivity"
            android:exported="false" />

        <activity
            android:name=".activities.HistoricoActivity"
            android:exported="false" />

        <activity
            android:name=".activities.FavoritosActivity"
            android:exported="false" />

        <activity android:name=".activities.ModeradorActivity" android:exported="false" />
        <activity android:name=".activities.DicionarioActivity" android:exported="false" />
    </application>

</manifest>