<?xml version='1.0' encoding='utf-8'?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F8FAFC">

    <!-- Área central -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_centerInParent="true" android:gravity="center" android:orientation="vertical">

        <ImageView android:id="@+id/imgLogo" android:layout_width="220dp" android:layout_height="220dp" android:src="@drawable/logo_connecta" android:contentDescription="Logo Connecta"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Connecta Libras" android:textColor="#0F172A" android:textSize="30sp" android:textStyle="bold"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Conectando pessoas sem barreiras" android:textColor="#64748B" android:textSize="16sp"/>

    </LinearLayout>

    <!-- Rodapé -->
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:layout_centerHorizontal="true" android:layout_marginBottom="24dp" android:text="Versão 1.0" android:textColor="#94A3B8" android:textSize="12sp"/>

</RelativeLayout>