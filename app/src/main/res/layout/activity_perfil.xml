<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F8FAFC">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Meu Perfil" android:textColor="#0F172A" android:textSize="28sp" android:textStyle="bold"/>

        <ImageView android:id="@+id/imgPerfil" android:layout_width="120dp" android:layout_height="120dp" android:layout_gravity="center" android:layout_marginTop="24dp" android:scaleType="fitCenter" android:src="@drawable/logo_connecta"/>

        <TextView android:id="@+id/txtNome" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="16dp" android:text="Usuário" android:textColor="#0F172A" android:textSize="24sp" android:textStyle="bold"/>

        <TextView android:id="@+id/txtEmail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:text="usuario@email.com" android:textColor="#64748B" android:textSize="14sp"/>

        <TextView android:id="@+id/txtTipoUsuario" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="8dp" android:text="Usuário de Libras" android:textColor="#14B8A6" android:textStyle="bold"/>

        <Button android:id="@+id/btnEditarPerfil" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="32dp" android:text="Editar Perfil" android:background="@drawable/bg_connecta_button" android:backgroundTint="@color/secondary" android:textColor="#FFFFFF"/>

        <Button android:id="@+id/btnConfiguracoes" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="12dp" android:text="Configurações" android:background="@drawable/bg_connecta_button" android:backgroundTint="@color/secondary" android:textColor="#FFFFFF"/>

        <Button android:id="@+id/btnHistorico" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="12dp" android:text="Histórico de Traduções" android:background="@drawable/bg_connecta_button" android:backgroundTint="@color/secondary" android:textColor="#FFFFFF"/>

        <Button android:id="@+id/btnSair" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="12dp" android:text="Sair" android:background="@drawable/bg_connecta_button" android:backgroundTint="@color/secondary" android:textColor="#FFFFFF"/>

    </LinearLayout>

</ScrollView>