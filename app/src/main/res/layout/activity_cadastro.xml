<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F8FAFC">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">

        <!-- Logo -->
        <ImageView android:id="@+id/imgLogo" android:layout_width="180dp" android:layout_height="180dp" android:layout_gravity="center" android:src="@drawable/logo_connecta"/>

        <!-- Título -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginTop="8dp" android:text="Criar Conta" android:textColor="#0F172A" android:textSize="28sp" android:textStyle="bold"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginBottom="24dp" android:text="Escolha seu perfil e preencha seus dados" android:textColor="#64748B"/>

        <!-- Tipo de usuário -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Tipo de usuário" android:textStyle="bold"/>

        <RadioGroup android:id="@+id/radioTipoUsuario" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical">

            <RadioButton android:id="@+id/rbLibras" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Usuário de Libras"/>

            <RadioButton android:id="@+id/rbOuvinte" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ouvinte"/>

        </RadioGroup>

        <!-- Nome -->
        <EditText android:id="@+id/edtNome" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="Nome completo"/>

        <EditText android:id="@+id/edtUsuario" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Nome de usuário" android:inputType="text" android:singleLine="true"/>
        <!-- Email -->
        <EditText android:id="@+id/edtEmail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="E-mail" android:inputType="textEmailAddress"/>

        <!-- Senha -->
        <EditText android:id="@+id/edtSenha" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Senha" android:inputType="textPassword"/>

        <!-- Confirmar senha -->
        <EditText android:id="@+id/edtConfirmarSenha" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Confirmar senha" android:inputType="textPassword"/>

        <!-- Botão -->
        <Button android:id="@+id/btnCadastrar" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="24dp" android:backgroundTint="@color/secondary" android:text="Criar Conta" android:textColor="#FFFFFF" android:textStyle="bold" android:background="@drawable/bg_connecta_button"/>

    </LinearLayout>

</ScrollView>