<?xml version='1.0' encoding='utf-8'?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F8FAFC">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal">

        <!-- Logo -->
        <ImageView android:id="@+id/imgLogo" android:layout_width="220dp" android:layout_height="220dp" android:layout_marginTop="20dp" android:src="@drawable/logo_connecta" android:contentDescription="Logo Connecta"/>

        <!-- Título -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bem-vindo" android:textColor="#0F172A" android:textSize="32sp" android:textStyle="bold"/>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Entre para continuar usando o Connecta Libras" android:textColor="#64748B" android:textSize="14sp" android:gravity="center"/>

        <!-- Campo Email -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="32dp" android:text="Usuário ou e-mail" android:textStyle="bold"/>

        <EditText android:id="@+id/edtEmail" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="8dp" android:backgroundTint="@color/secondary" android:hint="Digite seu usuário ou e-mail" android:inputType="text"/>

        <!-- Campo Senha -->
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Senha" android:textStyle="bold"/>

        <EditText android:id="@+id/edtSenha" android:layout_width="match_parent" android:layout_height="55dp" android:layout_marginTop="8dp" android:backgroundTint="@color/secondary" android:hint="Digite sua senha" android:inputType="textPassword"/>

        <!-- Esqueceu senha -->
        <TextView android:id="@+id/txtEsqueciSenha" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="12dp" android:text="Esqueceu sua senha?" android:textColor="#14B8A6" android:textStyle="bold"/>

        <!-- Botão Entrar -->
        <Button android:id="@+id/btnEntrar" android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="32dp" android:backgroundTint="@color/secondary" android:text="Entrar" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" android:background="@drawable/bg_connecta_button"/>

        <!-- Cadastro -->
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:orientation="horizontal">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Não possui conta? " android:textColor="#64748B"/>

            <TextView android:id="@+id/txtCadastrar" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cadastre-se" android:textColor="#14B8A6" android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>